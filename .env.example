# ============================================================
# Contact form integration (COPY THIS FILE TO .env TO ENABLE)
# Never commit your real .env — keys stay on your machine / Vercel env vars.
# ============================================================

# Option 1 — Formspree (simplest: no server code)
# Create a form at https://formspree.io and paste your endpoint below.
VITE_FORMSPREE_ENDPOINT=

# Option 2 — EmailJS
# Grab keys from your EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID=service_v7ro3aq
VITE_EMAILJS_TEMPLATE_ID=template_34i1oem
# EmailJS public key is safe to bundle, but prefer a backend relay where possible.
VITE_EMAILJS_PUBLIC_KEY=gt5s5_111BZ8JjyE6

# Option 3 — Your own backend API (most secure)
# Your server receives { name, email, message } via POST /contact and sends the mail.
VITE_CONTACT_API=