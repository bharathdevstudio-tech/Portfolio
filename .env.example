# ============================================================
# Contact form integration — example template
# Copy to .env (or .env.local for secrets) and fill in your values.
# Never commit real secrets. Vite exposes only VITE_-prefixed vars to the browser.
# ============================================================

# ---- Providers (tried in order; first success wins) ----

# 1) Formspree (simplest, no server code)
VITE_FORMSPREE_ENDPOINT=

# 2) Your own SMTP server (server-side, via api/contact.js).
#    Keep this enabled to route through SMTP. Add SMTP_* values below.
VITE_CONTACT_API=/api/contact

# 3) EmailJS (frontend-only fallback; used automatically if the SMTP route fails)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---- Server-only SMTP settings (read by api/contact.js) ----
# Set these in .env.local locally and in your hosting provider's env vars in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional — "true" for SSL (port 465); defaults to true when SMTP_PORT=465.
SMTP_SECURE=false
# Optional — recipient and From address (default to SMTP_USER).
CONTACT_TO=
CONTACT_FROM=

# ---- Cloudflare Pages only (set in the Cloudflare dashboard, not in .env) ----
# Cloudflare's Workers runtime cannot use SMTP/Nodemailer. Point this at your
# Vercel deployment's /api/contact URL to relay mail there from functions/api/contact.js.
# Leave it unset to let the Cloudflare deployment fall back to EmailJS.
# CONTACT_RELAY_URL=https://your-project.vercel.app/api/contact
