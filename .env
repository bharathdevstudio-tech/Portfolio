# ============================================================
# Contact form integration (COPY THIS FILE TO .env TO ENABLE)
# Never commit your real .env — keys stay on your machine / Vercel env vars.
# ============================================================

# Option 1 — Formspree (simplest: no server code)
# Create a form at https://formspree.io and paste your endpoint below.
VITE_FORMSPREE_ENDPOINT=

# Option 2 — EmailJS
# Grab keys from your EmailJS dashboard.
VITE_EMAILJS_SERVICE_ID=service_v7ro3aq
VITE_EMAILJS_TEMPLATE_ID=template_34i1oem
# EmailJS public key is safe to bundle, but prefer a backend relay where possible.
VITE_EMAILJS_PUBLIC_KEY=gt5s5_111BZ8JjyE6

# Option 3 — Your own SMTP server (most secure; runs server-side via api/contact.js)
# The browser posts to /api/contact, which relays the mail through Nodemailer.
# Put the real SMTP_* values in .env.local (gitignored) or your hosting
# provider's Environment Variables — never commit them.
VITE_CONTACT_API=/api/contact

# --- Server-only SMTP settings (read by api/contact.js, never sent to the browser)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
# CONTACT_TO=you@gmail.com
# CONTACT_FROM=you@gmail.com

