{
  // Cloudflare Workers deployment for this Vite single-page app.
  //
  // `npm run build` writes the site to ./dist; wrangler uploads that folder as
  // static assets and serves it with an SPA fallback (unknown paths return
  // index.html so client-side routing works).
  //
  // An explicit config also stops `wrangler deploy` from running autoconfig,
  // which otherwise tries to parse and rewrite vite.config.js.
  //
  // NOTE: `not_found_handling` must stay "single-page-application" here.
  // "404-page" was tried (2026-10-19) and it broke the live deployment — every
  // path including "/" returned a plain-text 404 with no assets served. This app
  // has no client-side router, so the SPA fallback only means unknown paths
  // return index.html (HTTP 200); the canonical host is the only URL published
  // in sitemap.xml, so that is not a practical soft-404 problem in practice.
  // public/404.html is kept for reference but is NOT wired up, on purpose.
  "$schema": "node_modules/wrangler/config-schema.json",
  // MUST match the Cloudflare Worker/Workers & Pages project that is bound to
  // https://portfolio.bharath-devstudio.workers.dev/. It was "bharath-portfolio",
  // so every deploy published to bharath-portfolio.bharath-devstudio.workers.dev
  // and left the "portfolio" project empty ("There is nothing here yet").
  "name": "portfolio",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
